{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dh-gestao",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "dhgest.lucast.app", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
